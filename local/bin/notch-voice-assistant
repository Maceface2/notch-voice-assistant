#!/usr/bin/env bash

set -euo pipefail

readonly PACKAGE_ROOT="/home/masono/.local/lib"
readonly VENV_PYTHON="/home/masono/.local/share/notch-voice-assistant/venv/bin/python"

if [[ -x "$VENV_PYTHON" ]]; then
    VENV_SITE="$("$VENV_PYTHON" -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"
    readonly VENV_SITE
    export PYTHONPATH="${PACKAGE_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
    export LD_LIBRARY_PATH="${VENV_SITE}/nvidia/cublas/lib:${VENV_SITE}/nvidia/cudnn/lib:${VENV_SITE}/nvidia/cuda_nvrtc/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
    exec "$VENV_PYTHON" -m notch_voice_assistant.cli "${1:-toggle}"
fi

export PYTHONPATH="${PACKAGE_ROOT}${PYTHONPATH:+:${PYTHONPATH}}"
exec /usr/bin/python3 -m notch_voice_assistant.cli "${1:-toggle}"
